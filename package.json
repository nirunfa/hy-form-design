{
  "name": "hy-form-design",
  "version": "1.0.1",
  "private": false,
  "description": "基于vue、ant-design-vue的表单设计器,可视化开发表单,n次开发定制版",
  "license": "MIT",
  "author": "nirunfa",
  "keywords": [
    "ant-design",
    "form",
    "hy-form-design",
    "表单设计器",
    "表单设计",
    "可视化",
    "工作流"
  ],
  "bugs": {
    "url": "https://github.com/nirunfa/hy-form-design/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nirunfa/hy-form-design"
  },
  "main": "lib/hy-form-design-mini.umd.min.js",
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "lib": "vue-cli-service build --target lib --name hy-form-design --dest lib packages/index.js && npm run lib:mini",
    "lib:mini": "vue-cli-service build --target lib --name hy-form-design-mini --dest lib packages/mini.js --no-clean",
    "lint-fix": "eslint --fix --ext .js --ext .jsx --ext .vue packages/",
    "lint": "vue-cli-service lint"
  },
  "dependencies": {
    "ant-design-vue": "1.7.8",
    "babel-polyfill": "^6.26.0",
    "clipboard": "^2.0.6",
    "core-js": "^3.1.2",
    "moment": "^2.24.0",
    "vcolorpicker": "^1.1.0",
    "vue": "2.7.16",
    "vue-codemirror-lite": "^1.0.4",
    "vue-quill-editor": "^3.0.6",
    "vue-router": "^3.0.3",
    "vuedraggable": "^2.23.2"
  },
  "devDependencies": {
    "@vue/cli-plugin-babel": "^4.0.4",
    "@vue/cli-plugin-eslint": "^4.0.4",
    "@vue/cli-service": "^4.2.3",
    "@vue/eslint-config-prettier": "^5.0.0",
    "babel-eslint": "^10.0.1",
    "babel-plugin-transform-class-properties": "^6.24.1",
    "eslint": "^5.0.0",
    "eslint-plugin-prettier": "^3.1.0",
    "eslint-plugin-vue": "^5.0.0",
    "less": "^3.0.4",
    "less-loader": "^4.1.0",
    "prettier": "^1.18.2",
    "vue-template-compiler": "2.7.16"
  },
  "resolutions": {
    "minimatch": "^7.0.0",
    "stylelint-config-recommended": "^12.0.0"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "@vue/prettier"
    ],
    "rules": {
      "prefer-const": "error",
      "no-console": 0
    },
    "parserOptions": {
      "parser": "babel-eslint"
    }
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ]
}
