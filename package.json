{
  "name": "hy-form-design",
  "version": "2.0.0",
  "private": false,
  "description": "基于vue、ant-design-vue的表单设计器,可视化开发表单,n次开发定制版",
  "license": "MIT",
  "author": "nirunfa",
  "keywords": [
    "ant-design",
    "form",
    "hy-form-design",
    "表单设计器",
    "表单设计",
    "可视化",
    "工作流"
  ],
  "bugs": {
    "url": "https://github.com/nirunfa/hy-form-design/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nirunfa/hy-form-design"
  },
  "main": "lib/hy-form-design.es.js",
  "module": "./lib/hy-form-design.es.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/hy-form-design.es.js",
      "require": "./lib/hy-form-design.umd.js",
      "types": "./lib/types/index.d.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "lib": "vite build",
    "lib:mini": "vite build --config vite.mini.config.js",
    "lint-fix": "eslint --fix --ext .js --ext .jsx --ext .vue packages/",
    "lint": "vite lint",
    "pub": "node scripts/publish.js",
    "pub:dry-run": "node scripts/publish.js --dry-run",
    "pub:mini": "node scripts/publish-mini.js",
    "pub:mini:dry-run": "node scripts/publish-mini.js --dry-run"
  },
  "dependencies": {
    "ant-design-vue": "1.7.8",
    "babel-polyfill": "^6.26.0",
    "clipboard": "^2.0.6",
    "core-js": "^3.1.2",
    "moment": "^2.24.0",
    "vcolorpicker": "^1.1.0",
    "vue": "2.7.16",
    "vue-codemirror": "4",
    "vue-quill-editor": "^3.0.6",
    "vue-router": "^3.0.3",
    "vuedraggable": "^2.23.2"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@vitejs/plugin-vue2": "^2.3.4",
    "babel-eslint": "^10.0.1",
    "babel-plugin-transform-class-properties": "^6.24.1",
    "eslint": "^5.0.0",
    "eslint-plugin-prettier": "^3.1.0",
    "eslint-plugin-vue": "^5.0.0",
    "less": "^3.0.4",
    "less-loader": "^4.1.0",
    "prettier": "^1.18.2",
    "vite": "4",
    "vite-plugin-commonjs": "^0.10.4",
    "vite-plugin-require": "^1.2.14",
    "vue-template-compiler": "2.7.16"
  },
  "resolutions": {
    "minimatch": "^7.0.0",
    "stylelint-config-recommended": "^12.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "@vue/prettier"
    ],
    "rules": {
      "prefer-const": "error",
      "no-console": 0
    },
    "parserOptions": {
      "parser": "babel-eslint"
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ]
}
